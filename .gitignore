# ----------------------------------------------------------------------
# Rust & Cargo
# ----------------------------------------------------------------------
# Build artifacts
target/
**/target/

# Backup files generated by rustfmt
**/*.rs.bk

# ----------------------------------------------------------------------
# Project Specific (Reverse Flow Context)
# ----------------------------------------------------------------------
# The binary index file containing the memory-mapped graph
.reverseflow.index
.index

# Temporary test directories if created manually
tmp/
temp/

# ----------------------------------------------------------------------
# Node.js / Frontend (SolidJS + Tailwind)
# ----------------------------------------------------------------------
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log*

# Build outputs for the frontend
dist/
build/

# Local Environment variables
.env
.env.local
.env.*.local

# ----------------------------------------------------------------------
# Tauri
# ----------------------------------------------------------------------
# Tauri build artifacts (often inside src-tauri)
src-tauri/target/

# Tauri generated files (for Android/iOS/Capabilities)
src-tauri/gen/

# Tauri internal cache
.tauri/

# ----------------------------------------------------------------------
# IDE & OS System Files
# ----------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# VS Code (Optional: You might want to allow extensions.json)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# JetBrains
.idea/
*.iml
