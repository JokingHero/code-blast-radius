+            lang: SupportedLanguage::Json,
+            name: "JSON: Trailing Comma/Bad Syntax",
+            code: "{ \"key\": \"value\", }",
+        },
+        MalformedCase {
+            lang: SupportedLanguage::Yaml,
+            name: "YAML: Bad Tab/Space Mix",
+            code: "key:\n\tvalue", // YAML forbids tabs
+        }
+    ];
